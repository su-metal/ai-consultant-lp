# Resend API key (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Verified sender address in Resend (required)
# e.g. inquiry@machinami0924.com
# Resend で認証済みドメインのメールアドレスを指定してください
CONTACT_FROM_EMAIL=inquiry@example.com

# Recipient(s) for free consultation inquiries
# カンマ区切りで複数指定できます
CONTACT_TO_EMAIL=info@machinami0924.com
